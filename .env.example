# Back (gateway) — copy to .env, fill with real values
# See docs/style/REPO_RULES.md § Security, infra/README.md

PORT=3000
HOST=0.0.0.0

# S3/MinIO
FS_S3_ENDPOINT=http://localhost:9000
FS_S3_ACCESS_KEY=minioadmin
FS_S3_SECRET_KEY=minioadmin
FS_S3_BUCKET=birdmaid-dev

# Optional: public URL for presigned (e.g. s3.shell.local)
# FS_S3_PUBLIC_URL=

# Optional: TTL for signed URLs (seconds)
# FS_SIGNED_URL_TTL_SEC=3600
