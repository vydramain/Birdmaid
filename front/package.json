{
  "name": "birdmaid-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --mode mobile",
    "build": "vite build",
    "build:mobile": "vite build --mode mobile",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "! grep -rE '\\.skip|\\.only|test\\.todo|describe\\.todo' __tests__ && vitest run --coverage",
    "coverage": "vitest run --coverage",
    "preview": "node server.js",
    "preview:mobile": "vite preview --mode mobile",
    "lint": "eslint . --ext .ts,.tsx && stylelint '**/*.css' '**/*.scss' && node scripts/check-inline-styles.cjs",
    "lint:js": "eslint . --ext .ts,.tsx",
    "lint:css": "stylelint '**/*.css' '**/*.scss'",
    "lint:staged": "lint-staged",
    "lint:fix": "eslint . --ext .ts,.tsx --fix && stylelint '**/*.css' '**/*.scss' --fix",
    "prepare": "husky install"
  },
  "dependencies": {
    "@mui/material": "^5.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "jsdom": "^24.0.0",
    "http-server": "^14.1.1",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.1.0",
    "vitest": "^1.3.0"
  }
}
